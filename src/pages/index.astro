---
import '../styles/global.css';
import App from '../components/App.svelte';

const title = 'DiscLens — Explora, reproduce y convierte el contenido de tus discos';
const description =
  'Abre DVD, CD, Blu-ray y discos de datos desde el navegador. Descubre qué hay realmente dentro, reproduce vídeo, música y fotos, y conviértelos a MP4, MKV, MP3, WAV, PNG y más. Sin subir nada: todo ocurre en tu equipo.';
const downloadUrl = import.meta.env.PUBLIC_DESKTOP_DOWNLOAD_URL ?? 'https://github.com/anxo0/disc_explorer/releases/latest';
---

<!doctype html>
<html lang="es" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="dark light" />
    <meta name="theme-color" content="#0a0b0e" />
    <link rel="icon" href="favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="twitter:card" content="summary" />
    <script is:inline>
      // Tema e idioma antes del primer pintado (oscuro por defecto).
      (function () {
        var root = document.documentElement;
        try {
          if (localStorage.getItem('disclens:theme') === 'light') root.dataset.theme = 'light';
          var lang = new URLSearchParams(location.search).get('lang') || localStorage.getItem('disclens:lang');
          if (!lang) lang = (navigator.language || 'es').toLowerCase().indexOf('es') === 0 ? 'es' : 'en';
          root.lang = lang === 'en' ? 'en' : 'es';
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <App client:only="svelte" desktopUrl={downloadUrl} />
    <noscript>
      <p style="padding:2rem;font-family:sans-serif">DiscLens necesita JavaScript. / DiscLens requires JavaScript.</p>
    </noscript>
  </body>
</html>
