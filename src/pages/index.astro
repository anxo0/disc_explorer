---
import Base from '../layouts/Base.astro';
import Landing from '../components/site/Landing.svelte';

const downloadUrl = import.meta.env.PUBLIC_DESKTOP_DOWNLOAD_URL ?? 'https://github.com/anxo0/disc_explorer/releases/latest';
---

<Base
  title="DiscLens — Mira lo que hay de verdad en tus discos"
  description="Abre DVD, CD, Blu-ray y discos de datos desde el navegador. Reproduce vídeo, música y fotos y conviértelos a MP4, MKV, MP3, WAV, PNG y más. Sin subir nada: todo ocurre en tu equipo."
>
  <Landing client:only="svelte" desktopUrl={downloadUrl} />
</Base>
